[Unit]
Description=AI-OS.NET 呈现（Python 半）—— 一块屏的呈现设施：订总线、只合 shown 的画布、推给 A2UI 渲染器

[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/src/presentation
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_SCREEN_NAME=screen0
Environment=AIOS_RENDER_PORT=7450
ExecStart=/usr/bin/python3 /usr/lib/aios/src/presentation/presentation_process.py
Restart=always
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
