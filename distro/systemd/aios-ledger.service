[Unit]
Description=AI-OS.NET 账房（Python）—— 站在总线旁边抄一份：世界发生过什么
Documentation=https://ai-os.net/docs/ledger
# ★★★ 四个独立进程，谁也不等谁 ⇒ 不 After=／不 Wants=／不 Requires=。

[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/py
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_WORLD_LEDGER=/var/lib/aios/world/traffic.jsonl
ExecStart=/usr/bin/python3 /usr/lib/aios/py/ledger_process.py
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aios/world
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
