[Unit]
Description=AI-OS.NET 本体进程（Python）—— 世界唯一的耦合点：只认、只盖章、只转、只记
Documentation=https://ai-os.net/docs/ontology
# ★★★ 作者定基调：一个总线 ＋ 一个本体 ＋ 相关进程。
#   ⇒ 本体【不等】总线（不 After=/不 Wants=/不 Requires=）；连不上就 Restart 自己重试。

[Service]
Type=simple
# ★★ 本体用 Python —— 因为 Rust 的 zenoh 在本机两种模式都不行（T-334 现取）。
#   而且 client 模式【跨进程能通】是实测过的。
WorkingDirectory=/usr/lib/aios/py
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_REGISTRY=/var/lib/aios/ontology/registry.jsonl
Environment=AIOS_LEDGER=/var/lib/aios/ontology/ledger.jsonl
Environment=AIOS_BUS=tcp/127.0.0.1:7447
ExecStart=/usr/bin/python3 /usr/lib/aios/py/ontology_process.py
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# ★ 本体要写自己的注册表和账本
ReadWritePaths=/var/lib/aios/ontology
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
