[Unit]
Description=AI-OS.NET Ontology (语义世界权威 ＋ 注册/个体面)
Documentation=https://ai-os.net/docs/ontology
# ★★★ 作者裁（逐字）：「**本体，和总线两个不要有瓜葛，总线单独起**」。
# ★★ 所以这里【不 After=/Wants= 总线】—— ★ 连不上总线是【运行时的事】。

[Service]
Type=simple
# ★★ 与上游其余单元的一处【已知差异】：其余走 'aios-system run-service <名字>'；
#   本体进程是 'crates/aios-worldcore' 的一支 bin。
# ★★★ **总线配置必须 `mode: peer`**（★ 实测：`mode: client` 在 systemd 的服务环境里
#    连不上 `zenohd`；★ `mode: peer` 能连上 —— ★ 现象清楚、原因未考）。
Environment=ZENOH_CONFIG=/etc/aios/zenoh.json5
ExecStart=/usr/lib/aios/aios-ontology /usr/lib/aios/ontology.json /var/lib/aios/ontology/registry.jsonl
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
RuntimeDirectory=aios
ReadWritePaths=/var/lib/aios/ontology
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
