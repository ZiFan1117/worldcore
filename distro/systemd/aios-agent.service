[Unit]
Description=AI-OS.NET 真 agent（Python）—— 模型在环里：自己决定做什么、自己决定画什么；全走本体
After=aios-bus.service aios-ontology.service aios-carrier.service aios-gui.service
Wants=aios-bus.service aios-ontology.service aios-carrier.service aios-gui.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/aios/py/agent_llm.py
Restart=always
RestartSec=8
Environment=PYTHONIOENCODING=utf-8
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_AGENT_NAME=dsh
Environment=AIOS_AGENT_ROUND=45
# ★★ API key 不进 unit（★ 单独放 /etc/aios/llm.env，★ 权限 600）
EnvironmentFile=-/etc/aios/llm.env
ProtectSystem=strict
ReadWritePaths=/var/lib/aios /run/aios
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
