[Unit]
Description=AI-OS.NET GUI（Python）—— 世界 ↔ 人 之间那一面（类 ＝ surface）
Documentation=https://ai-os.net/docs/gui
# ★★★ 作者：四个独立进程，谁也不等谁 ⇒ 不 After=／不 Wants=／不 Requires=。

[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/py
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_GUI_FRAME_OUT=/run/aios/gui-frame.json
ExecStart=/usr/bin/python3 /usr/lib/aios/src/gui/gui_process.py
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
RuntimeDirectory=aios
ReadWritePaths=/run/aios
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
