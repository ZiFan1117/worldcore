[Unit]
Description=世界核心 · 内核进程（唯一写者）
Documentation=man:systemd.service(5) man:systemd.exec(5)
# ★★ `Sockets=` **已删**（Lead 裁 2026-10-05；理由＝本席自己现取的原文）：
#   本机 systemd 逐字 `world-core.service:12: Unknown key 'Sockets' in section [Unit], ignoring.`
#   ⇒ ★**它是一个"没有执行体"的键** —— ★与 `FileDescriptorStorePreserve` **同一类**
#     （★"加了一个不会生效的键" ＝ "把没做到写成做到了"的**配置版**）。
#   ★★ **真正让 n 个 fd 一起到的机制 ＝ socket 单元里那句 `Service=world-core.service`**：
#     systemd 把所有 `Service=` 指向**同一个服务**的**活跃 socket** 的 fd **一起交给该服务**。
#     ⇒ ★现取（T29，`2026-10-05T15:03:19`）：重启后 `LISTEN_FDS=2`，且 `/run/` 两个口都在。
#   ⇒ ★**(甲-e) 的服务侧【不需要任何新键】**（§② 照此改写）。
#   ★ 剩下那一格在代码侧：★`cmd_serve` 的**多口受理**（`bus` 的件；★现取已成立：`ListenFdsAccepted`）。
#
# ★★★ **载体【不依赖任何具体应用的口单元】** —— 判据逐字（`cargo test --locked --test carrier_boundary`
#   的 `c01_unit_dependencies_must_not_point_at_applications`）：★"载体件的依赖**不许指向具体应用**（运行轴与依赖轴不许混）"。
#   ★ 我 2026-10-05 曾把 `world-core-omarchy.socket` 加进下面两行（为了那个口上线）⇒ ★**判据当场红**，逐字：
#     `["world-core.service: Requires=world-core-omarchy.socket", "world-core.service: After=world-core-omarchy.socket"]`
#   ⇒ ★**已撤回那一半**，并回 `world-core.socket` **单条**（★它是**载体自己的总线口**，不是"某个应用"）。
#   ★★ **诊断（为什么那两行不是必需的）**：★n 个 fd 的交付＝
#     ★① 每个口单元里的 `Service=world-core.service` 配对（★systemd 把所有指向同一服务的**活跃 socket** 的 fd 一起交给它）
#     ＋ ★② 两个口单元都在 `sockets.target` 里（★boot 时先起口，服务由连接激活）⇒
#     ★现取（T29/T37b）：`LISTEN_FDS=2` 且两口都受理 ⇒ ★**与这两行无关**。
#   ★ 若将来确需表达"服务启动前所有口都在位" ⇒ ★**用【载体自己的聚合单元】**（一个 target，
#     由各应用的口单元 `WantedBy=` 它；载体只依赖那个 target）⇒ ★**加一个应用不必改载体**，
#     且"运行轴/依赖轴不许混"守得住。★**留给需要时再做，现在不加**（★一次一个变量）。
Requires=world-core.socket
After=world-core.socket

[Service]
Type=notify
NotifyAccess=main
# 就绪门槛：先自检再对外可用。四条件不齐 ⇒ 不发 READY ⇒ 载体不认为它起来了
# ★★ 口属主的落地（2026-10-05；**盘上先有、仓内后补** ⇒ 这一条正是"部署漂移"的修复）：
#   `RuntimeDirectory=world-core` 的递归 chown 会把 `/run/world-core/omarchy.sock` 的属主
#   盖回服务的 `User=`（965）⇒ 而 `channel.json` 说那个口属于 `world://presence/omarchy`（uid 963）。
#   ⇒ 用下面这一行在**递归之后**把它改回来。
# ★★★ **命门是两个字符 `+`**：`ExecStartPre` 默认跑在【已降权】的服务身份下 ——
#   沙箱同形装置实测：**去掉 `+` ⇒ `chown` 改不动、而且被后一趟递归 chown 静默盖掉**（**服务仍报 success**）。
#   `+` ⇒ 以完全权限跑 ⇒ ①改得动 ②落在最后。
#   ★ 判据：`tools/chown_plus_guard.py`（P-01 盯这个 `+`、P-02/P-03 盯"仓内 ↔ 盘上不许漂移"）。
# ★★ 2026-10-05 同日再补一条：`dsh` 口（`world://agent/dsh`，uid 962）走**[同一个机制]** ——
#   口建在同一个 `RuntimeDirectory=` 里 ⇒ 同样被递归 chown 盖成 `User=` ⇒ 同样要用 `+chown` 在**递归之后**改回来。
#   两条**各自点名一个具体的口**（不是目录）；★ 少一条 ⇒ 那个口的属主静默走回 965，
#   而 `tools/socket_uid_guard.py` **会在下次读盘时红**（盘上 uid ≢ 法律那条 uid）。
ExecStartPre=+/bin/chown omarchy:omarchy /run/world-core/omarchy.sock
ExecStartPre=+/bin/chown dsh:dsh /run/world-core/dsh.sock
ExecStart=/usr/bin/world-core --ontology /etc/world-core/ontology.json --ledger /var/lib/world-core/ledger.jsonl --policy /etc/world-core/policy.json --channel /etc/world-core/channel.json --cap-dir /etc/world-core/cap.d --owner-uid 965 serve
Restart=on-failure
RestartSec=2s
# 看门狗：进程必须周期性报到，否则视为卡死并重启
WatchdogSec=30s

# ── 身份与权限：法律与真相必须在这个身份之下 ──
User=world-core
Group=world-core
StateDirectory=world-core
StateDirectoryMode=0700
RuntimeDirectory=world-core
RuntimeDirectoryMode=0755
# 配置目录不 chown 给本用户：法律必须由部署方写，进程只能读
ConfigurationDirectory=world-core
ConfigurationDirectoryMode=0755

# ── 内核语义类约束（内核强制，不依赖"尽力而为"档）──
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
# 只读挂载之外，仅允许写状态目录与运行目录
ReadWritePaths=/var/lib/world-core /run/world-core

# ── 资源 ──
MemoryMax=2G
CPUQuota=100%
TasksMax=64

# ── 停机：先把该落的落完，再退 ──
KillSignal=SIGTERM
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
