<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AI-OS.NET</vendor>
  <vendor_url>https://ai-os.net</vendor_url>
  <action id="net.ai-os.worldcore.action.job.cancel">
    <description>job.cancel</description>
    <message>需要授权才能执行 job.cancel</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">job.cancel</annotate>
    <annotate key="net.ai-os.worldcore.what">job.cancel</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不删除作业记录；不把已发生的载体动作变成没发生</annotate>
    <annotate key="net.ai-os.worldcore.who"></annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.job.finish">
    <description>job.finish</description>
    <message>需要授权才能执行 job.finish</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">job.finish</annotate>
    <annotate key="net.ai-os.worldcore.what">job.finish</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不删除作业记录；不代替载体执行作业</annotate>
    <annotate key="net.ai-os.worldcore.who"></annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.job.start">
    <description>job.start</description>
    <message>需要授权才能执行 job.start</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">job.start</annotate>
    <annotate key="net.ai-os.worldcore.what">job.start</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不自行放行（准不准做由门禁判）；不代替载体执行作业</annotate>
    <annotate key="net.ai-os.worldcore.who"></annotate>
    <annotate key="net.ai-os.worldcore.implemented">has_entry</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.ledger.compact">
    <description>ledger.compact</description>
    <message>需要授权才能执行 ledger.compact</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">ledger.compact</annotate>
    <annotate key="net.ai-os.worldcore.what">ledger.compact</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不自行放行（准不准做由门禁判）；不可逆——本能力没有撤销路径</annotate>
    <annotate key="net.ai-os.worldcore.who">world://user</annotate>
    <annotate key="net.ai-os.worldcore.implemented">has_entry</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.notice.mute">
    <description>notice.mute</description>
    <message>需要授权才能执行 notice.mute</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">notice.mute</annotate>
    <annotate key="net.ai-os.worldcore.what">notice.mute</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不删除那条通告；不替别的通告静音</annotate>
    <annotate key="net.ai-os.worldcore.who">world://user,world://agent/dsh</annotate>
    <annotate key="net.ai-os.worldcore.implemented">has_entry</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.notice.unmute">
    <description>notice.unmute</description>
    <message>需要授权才能执行 notice.unmute</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">notice.unmute</annotate>
    <annotate key="net.ai-os.worldcore.what">notice.unmute</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不删除那条通告；不撤销撤回（`retract_seq` 是另一条路）</annotate>
    <annotate key="net.ai-os.worldcore.who">world://agent/dsh</annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.presence.report">
    <description>presence.report</description>
    <message>需要授权才能执行 presence.report</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">presence.report</annotate>
    <annotate key="net.ai-os.worldcore.what">presence.report</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不代表别人报告；不裁定自己有没有许可（由 `permissions.grants` ＋ `default: deny` 决定）</annotate>
    <annotate key="net.ai-os.worldcore.who">world://user</annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.world.migrate">
    <description>world.migrate</description>
    <message>需要授权才能执行 world.migrate</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">world.migrate</annotate>
    <annotate key="net.ai-os.worldcore.what">world.migrate</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不自行放行（准不准做由门禁判）；不可逆——本能力没有撤销路径</annotate>
    <annotate key="net.ai-os.worldcore.who"></annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
  <action id="net.ai-os.worldcore.action.world.rekey">
    <description>world.rekey</description>
    <message>需要授权才能执行 world.rekey</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="net.ai-os.worldcore.action">world.rekey</annotate>
    <annotate key="net.ai-os.worldcore.what">world.rekey</annotate>
    <annotate key="net.ai-os.worldcore.not_roles">不改写已落账的事件；不给自己发许可；不可逆——本能力没有撤销路径</annotate>
    <annotate key="net.ai-os.worldcore.who"></annotate>
    <annotate key="net.ai-os.worldcore.implemented">未定（原因＝按名在 `src/**` 里 0 命中，可能以别的名字实现）</annotate>
  </action>
</policyconfig>
