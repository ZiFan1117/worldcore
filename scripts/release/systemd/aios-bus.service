[Unit]
Description=worldcore Semantic Bus (zenoh)
Documentation=https://ai-os.net/docs/semantic-bus
# ★★★ 作者裁（逐字）：「**本体，和总线两个不要有瓜葛，总线单独起**」。
# ★★ 所以这里【没有任何 Before=/After=/Wants= 指向别的单元】—— ★ 它自己起、自己活。
#    （★ 早先我写过 Before=aios-ontology.service …，★ 那是错的口径，已撤。）

[Service]
Type=simple
# ★★ 与其它单元的差别：它们都走 '/usr/lib/aios/aios-system run-service <名字>'，
#   而总线用的是 zenoh 自带的守护进程 —— ★ 因为总线【就是 zenoh】（作者裁「换 Zenoh」）。
#   ⇒ ★ 待办：要么把 zenohd 收进 aios-system，要么接受这处差异并把它写进发行说明。
# ★ 总线自己的连接配置（★ 它 listen 不需要，但保持一致）
Environment=ZENOH_CONFIG=/etc/aios/zenoh.json5
ExecStart=/usr/lib/aios/zenohd -c /etc/aios/zenoh.json5 --listen tcp/127.0.0.1:7447
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# ★ 总线只读网络 ＋ 不需要写盘（zenoh 默认不持久；持久在我们自己的账里）
# ★★ 用 RuntimeDirectory 让 systemd 自己建 /run/aios —— ★ 直接写 ReadWritePaths=/run/aios 时
#    ★ 目录不存在 ⇒ 报 226/NAMESPACE（★ 我第一次就是这么炸的）。
RuntimeDirectory=aios
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
