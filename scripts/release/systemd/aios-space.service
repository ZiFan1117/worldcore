[Unit]
Description=worldcore 个人空间 —— 人的地盘：报 space、出桌面画布、收人的动作

[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/src/space
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_USER=zhang
Environment=AIOS_SPACE_STATE=active
ExecStart=/usr/bin/python3 /usr/lib/aios/src/space/space_process.py
Restart=always
RestartSec=3
PrivateTmp=yes
# ★★ 加固：只连 zenoh、报个体、出画布／记布局。
# ★★ 2026-10-20：P8 掉线补推要落【游标】到 /var/lib/aios/cursors ⇒ 只放开这一个目录
#   （其余仍 ProtectSystem=strict 只读）。★ 现取教训：不给它写权限时游标写失败是
#   `Read-only file system`，被 except 静默吞掉——现在写失败会打日志、且单元显式放开。
ProtectSystem=strict
ReadWritePaths=-/var/lib/aios/cursors -/var/lib/aios/scenes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
