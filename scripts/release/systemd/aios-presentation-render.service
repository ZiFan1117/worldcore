[Unit]
Description=worldcore 呈现（渲染半 · Flutter）—— ★ 呈现的一部分：收合成清单、按 layout 叠、画上屏
Documentation=https://ai-os.net/docs/presentation
# ★★★ 名字【必须带 presentation】—— 它不是独立的「渲染器进程」，
#     是「借来的渲染引擎（genui）＋ 我们的进程」，合起来才是【呈现】。
#     ★ 作者令（逐字）：「我们现在不是叫呈现吗？怎么会有这个东西呢」
# ★ 从属：呈现（Python 半）停了它跟着停；反过来不绑。
PartOf=aios-presentation.service
#   ★ 但它【必须】在有 X 之后才有屏 —— 所以只对 graphical 目标挂 WantedBy，不硬拉。

[Service]
Type=simple
WorkingDirectory=/opt/aiosr/build/linux/x64/release/bundle
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/lightdm/root/:0
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=GDK_BACKEND=x11
Environment=HOME=/root
ExecStart=/opt/aiosr/build/linux/x64/release/bundle/aios-presentation-render
Restart=always
RestartSec=5
# ★★ 加固：只读系统区（/usr、/boot、/efi、/etc）。它自己的程序在 /opt（不受影响），
#   ★ 它要写的 /tmp、/root（HOME）、/run 都保持可写。
ProtectSystem=full
# ★★★ 故意【不加】ProtectHome=read-only：现取它的 cgroup 里就有
#   xdg-document-portal（fusermount3 -- /root/.cache/doc）＋ gvfsd-fuse（/root/.gvfs）＋ dbus-launch，
#   ★ 它们都要写 $HOME（HOME=/root）⇒ 掐了 HOME 会把这一串 portal 弄崩。
# ★★★ 也【故意不改】PrivateTmp：DISPLAY=:0 的本地 socket 在 /tmp/.X11-unix/X0（现取），
#   换成 PrivateTmp=yes 会把这个路径藏掉、只剩 abstract socket ⇒ 有黑屏风险（★ 作者令：别把它弄崩）。
PrivateTmp=no
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
