[Unit]
Description=worldcore 呈现（Python 半）—— 一块屏的呈现设施：订总线、只合 shown 的画布、推给 A2UI 渲染器

[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/src/presentation
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_SCREEN_NAME=screen0
Environment=AIOS_RENDER_PORT=7450
ExecStart=/usr/bin/python3 /usr/lib/aios/src/presentation/presentation_process.py
Restart=always
RestartSec=3
PrivateTmp=yes
# ★★ 加固：源码逐行读过（presentation_process.py）—— 它只做三件：
#   ① 连 zenoh（client）② 起本机 TCP 桥 127.0.0.1:7450 ③ 画布只存内存（self.shown）。
#   ⇒ ★ 不写盘 ⇒ ★ 不给 ReadWritePaths（★ 给了反而是洞）。
ProtectSystem=strict
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
