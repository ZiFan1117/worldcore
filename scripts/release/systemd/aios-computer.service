[Unit]
Description=AI-OS.NET 计算机（Python）—— 这台机器在【世界里】的代言与执行
Documentation=https://ai-os.net/docs/computer
# ★★★ 作者：四个独立进程，谁也不等谁 ⇒ 不 After=／不 Wants=／不 Requires=。

# ★★★ 2026-10-18 判：★ ProtectSystem=full【就是该的】，不是将就。
#   ★ 代价要说清：★ 写 /etc 的动作（sys.AddPackageRepository 等）和
#     usermod／hostnamectl 一类在 full 下【会失败】。
#   ★★ 那是【故意的】—— ★ 执行器【不该】替人改系统级配置；
#     真要改，★ 该由【人】在【接入】那一侧做，★ 不是执行器偷偷做。
#   ★ 要 156 条全活只能 ProtectSystem=no（★ 等于不加固）⇒ ★ 不取。
[Service]
Type=simple
WorkingDirectory=/usr/lib/aios/py
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_BUS=tcp/127.0.0.1:7447
Environment=AIOS_COMPUTER_MAP=/usr/lib/aios/command-map.jsonl
ExecStart=/usr/bin/python3 /usr/lib/aios/src/computer/computer_process.py
Restart=always
RestartSec=3
LimitNOFILE=65536
PrivateTmp=yes
# ★★ 加固（逐条有据）：它是【执行器】—— 156 条 `sys.*` 映射 ⇒ subprocess 起程序 ＋ 文件类机制直接
#   open(path,"w")（★ 现读 computer_process.py 第 91–132 行）。★ 所以【不能】ProtectSystem=strict：
#   ★ strict 把【整个文件系统】挂成只读 ⇒ zypper／systemctl／usermod 这些真要去写 /etc、/usr 的动作
#   ★ 全会被 EROFS 打死 ⇒ 取 full（只读 /usr、/boot、/efi、/etc；/var、/tmp、/home 仍可写）。
#   ★ 边界（如实）：写 /etc 的动作（sys.AddPackageRepository 等）与 usermod/userdel 在 full 下仍会失败；
#   ★ 那是 full 的代价，不是 bug —— 再放开就只能是 ProtectSystem=no（★ 那就不加固了）。
ProtectSystem=full
# ★ HOME 只留可读：不许借执行器的壳往 /home、/root 写东西
ProtectHome=read-only
# ★★ 但【设备】必须看得见：eject／brightnessctl／硬件类动作要 /dev、/sys
#   ⇒ PrivateDevices 必须 no（★ systemd 默认值就是 no，显式写出来，防以后被人一刀切成 yes）。
PrivateDevices=no
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
