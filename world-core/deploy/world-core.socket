[Unit]
Description=世界核心 · 写入总线（唯一写入口的入口）
Documentation=man:systemd.socket(5)
PartOf=world-core.service

[Socket]
# ★★【已被否掉的尝试 · 留档】（2026-10-05：先裁 (甲) → 判"会落成多口同一身份"）
#   此处**曾加过**第二条 `ListenStream=/run/world-core/omarchy.sock`（一个单元两条口）。
#   ★起因是这条现取原文（T26，`journalctl`）：`world-core-omarchy.socket: Socket service
#     world-core.service already active, refusing.` ⇒ **第二个 socket 单元起不来**。
#   ★但 `bus` 的机制读数 ＋ 本席复核判定：**`SocketUser=`／`SocketGroup=`／`SocketMode=` 是【单元级】的**
#     ⇒ 一个单元两条口 ⇒ **两条口同一属主** ⇒ **违背"一个口一个身份"**。
#   ⇒ ★**指令行已撤**：★不是因为"试错了难看"，而是因为它会与 `world-core-omarchy.socket`
#     **抢同一个 socket 路径**（两个单元 bind 同一 `/run/world-core/omarchy.sock`）⇒ ★**把 (甲-e) 的判别式搅浑**。
#   ★**这段记录留着**（"试过什么"要有痕；★旧值不抹）。
#   ★**现行形态＝(甲-e)**：★**每个口各一个 socket 单元**（各自 `SocketUser=`），
#     ★由 `world-core.service` 的 `Sockets=` 一次把 n 个 fd 交给服务（见 `world-core.service`）。
ListenStream=/run/world-core/world.sock
# 一个连接一个身份 ⇒ **一个口一个系统身份**，套接字收紧到 0600（只有属主连得上）。
# ★ 裁（2026-10-05）：三处口径统一为 **0600** —— 本单元 ＋ `src/bus/mod.rs::bind()` 的
#   `set_permissions(0o600)` ＋ 盘上那个套接字。此前本单元写 0660（"属组表达谁能连"）、
#   代码文档写 0600 ⇒ **同一个事实两个取值**，而生产路径走 socket activation（本单元持有
#   套接字、`bind()` 不参与）⇒ 盘上是 0660，与代码文档说的 0600 不一致，且没有任何东西会红。
#   ★ 不用 0660：属组只是"同一台机上的一群人"，而本项目要的是"**一个口一个身份**"——
#   用属组就等于允许组内任意成员冒充该口的身份（申请端口权限的过程就是加组）。
SocketMode=0600
SocketUser=world-core
SocketGroup=world-core
# 一次往返 = 两个连接（先意图、后结果），故不限制单次连接数；
# 同一时刻的排队长由内核控制（Backlog= 直接映射到 listen(2) 的 backlog）
Accept=no
# 服务重启期间保留排队中的请求（默认即 no = 不丢弃）
FlushPending=no
# ★ `FileDescriptorStorePreserve=no` **已删**（Lead 裁 2026-10-05）：本机 systemd 把它判为
#   `Unknown key … in section [Socket], ignoring.` ⇒ ★**这份声明【没有执行体】，只会在日志里刷一行噪音**；
#   ★"它想说什么"已经登记过（信息不丢），★留着它反而让读者以为"已经那样"。

[Install]
WantedBy=sockets.target
