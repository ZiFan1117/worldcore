{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world://protocol/v1/binding.schema.json",
  "title": "worldcore provider binding v1",
  "description": "provider 绑定 law 已有的 action/function；不新增 world 定义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "function", "registered_by", "registered_by_kind", "required_roles"],
  "properties": {
    "action": {"type": "string", "minLength": 3, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "function": {"type": "string", "minLength": 1},
    "registered_by": {"type": "string", "minLength": 1, "pattern": "^world://"},
    "registered_by_kind": {"type": "string", "minLength": 1},
    "required_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "version": {"type": "integer", "minimum": 1},
    "why": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
