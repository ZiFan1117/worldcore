{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world://protocol/v1/action-extension.schema.json",
  "title": "worldcore action/function extension package v1",
  "description": "软件安装时注册动作/函数。对象类型、接口、关系类型封闭；只允许 action/function 扩展。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "package", "namespace", "provider", "actions", "functions"],
  "properties": {
    "protocol": {"const": "world.action-extension.v1"},
    "package": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "namespace": {"type": "string", "minLength": 1, "pattern": "^ext\\.[a-z0-9_]+\\.[a-z0-9_]+$"},
    "provider": {"type": "string", "minLength": 1, "pattern": "^world://app/[A-Za-z0-9_.-]+$"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/action"}},
    "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/function"}}
  },
  "definitions": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "properties": {"type": "array", "items": {"$ref": "#/definitions/param"}}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["forward", "ledger", "read", "write", "execute", "notification"]}
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who"],
      "properties": {
        "who": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "label", "required_roles", "parameters", "result", "effects", "grant"],
      "properties": {
        "id": {"type": "string", "minLength": 5, "pattern": "^ext\\.[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z][a-z0-9_]*$"},
        "version": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "array", "items": {"$ref": "#/definitions/param"}},
        "result": {"$ref": "#/definitions/result"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/effect"}},
        "grant": {"$ref": "#/definitions/grant"},
        "idempotent": {"type": "boolean"}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry", "provider"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "pattern": "^fn:[A-Za-z0-9_.-]+$"},
        "entry": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
