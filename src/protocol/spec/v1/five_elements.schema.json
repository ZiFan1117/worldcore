{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world://protocol/v1/five-elements.schema.json",
  "title": "worldcore five-element registration bundle v1",
  "description": "五要素注册包：objects / links / interfaces / actions / functions。定义面与自带本体同构。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "provider", "objects", "links", "interfaces", "actions", "functions"],
  "properties": {
    "protocol": {"const": "world.protocol.v1"},
    "provider": {"type": "string", "minLength": 1, "pattern": "^world://[A-Za-z0-9_./-]+$"},
    "objects": {"type": "array", "items": {"$ref": "#/definitions/object"}},
    "links": {"type": "array", "items": {"$ref": "#/definitions/link"}},
    "interfaces": {"type": "array", "items": {"$ref": "#/definitions/interface"}},
    "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}},
    "functions": {"type": "array", "items": {"$ref": "#/definitions/function"}}
  },
  "definitions": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "type": {
          "enum": ["STRING", "INTEGER", "NUMBER", "BOOLEAN", "OBJECT", "OBJECT_REFERENCE", "ARRAY", "NULL"]
        },
        "required": {"type": "boolean"},
        "primary": {"type": "boolean"},
        "options": {"type": ["object", "null"]},
        "description": {"type": "string"}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "primary_key": {"type": "string"},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "properties": {"type": "array", "items": {"$ref": "#/definitions/property"}},
        "provider": {"type": ["string", "null"]},
        "authority": {"type": "object"},
        "metadata": {"type": "object"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source", "target", "cardinality"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "cardinality": {"enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "array", "items": {"$ref": "#/definitions/property"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "required_roles", "parameters", "effects"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["invoke", "read", "write"]},
        "required_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "array", "items": {"$ref": "#/definitions/property"}},
        "preconditions": {"type": "array"},
        "effects": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind"]}},
        "grant": {"type": "object"},
        "reversible": {"type": "boolean"},
        "on_failure": {"type": "string"}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry", "provider"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    }
  }
}
