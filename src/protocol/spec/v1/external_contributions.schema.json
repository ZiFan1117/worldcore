{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world://protocol/v1/external_contributions.schema.json",
  "title": "worldcore external contributions v1",
  "description": "外部软件贡献：data_sources / functions / actions。不是 world action/function 定义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "provider", "data_sources", "functions", "actions"],
  "properties": {
    "protocol": {"const": "world.external-contributions.v1"},
    "provider": {"type": "string", "minLength": 1, "pattern": "^world://"},
    "data_sources": {"type": "array", "items": {"$ref": "#/definitions/data_source"}},
    "functions": {"type": "array", "items": {"$ref": "#/definitions/function"}},
    "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}}
  },
  "definitions": {
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_type", "sync", "provenance", "mapping"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "object_type": {"type": "string", "minLength": 1},
        "sync": {"enum": ["pull", "push", "read_through"]},
        "provenance": {"type": "string", "minLength": 1},
        "mapping": {"type": "object"}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "args", "result"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "args", "result", "side_effects"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result": {"type": "string", "minLength": 1},
        "side_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
